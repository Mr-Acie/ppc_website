# =============================================================================
# Mighty Elders quiz integrations
# =============================================================================
#
# Set these in your Vercel project: Settings > Environment Variables.
# Mark them as available to "Production" (and "Preview" if you want preview
# deployments to also send live emails — usually you do NOT).
#
# After adding them in Vercel, trigger a redeploy so the running build picks
# them up. Local dev just needs them in a .env.local file (which is gitignored).

# ---- Resend (instant welcome email) ----
# Sign up: https://resend.com
# Create an API key here: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address shown to recipients. The domain must be verified in
# Resend (Domains > Add Domain > add the DNS records). Until you verify
# pamperedcompanioncare.org, you can use the Resend test sender:
#   RESEND_FROM_EMAIL="Mighty Elders <onboarding@resend.dev>"
# In production, use your real domain:
RESEND_FROM_EMAIL="Acie Grimes <acie@pamperedcompanioncare.org>"

# ---- ConvertKit / Kit (nurture sequence) ----
# Sign up: https://kit.com
# Find your v3 API secret in: Account Settings > API Keys
CONVERTKIT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Create a form in Kit called "Mighty Elders AI Confidence Quiz" and grab the
# numeric ID from the URL (https://app.kit.com/forms/<FORM_ID>/edit).
CONVERTKIT_FORM_ID=1234567

# ---- Admin dashboard ----
# A random long string. Visit /mighty-elders/admin?token=<value> to view
# the dashboard. Anyone with this token can see the leads list — keep it
# secret. Generate with: openssl rand -base64 32
MIGHTY_ELDERS_ADMIN_TOKEN=replace-with-a-long-random-string
